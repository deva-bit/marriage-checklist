rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Put your Gmail and your girlfriend's Gmail here.
      allow read, write: if request.auth != null
        && request.auth.token.email in ['YOUR_EMAIL@gmail.com', 'HER_EMAIL@gmail.com'];
    }
  }
}
